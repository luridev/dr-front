{
  "name": "@protoapps/dr-front",
  "version": "0.2.1",
  "description": "Vue 3 UI components with sensible defaults and useful extras",
  "license": "MIT",
  "repository": "github:luridev/dr-front",
  "homepage": "https://github.com/luridev/dr-front#readme",
  "bugs": "https://github.com/luridev/dr-front/issues",
  "author": "Anton V.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/types/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && npm run generate:icons:check && vite build",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "check:commit": "npm run lint && npm run typecheck && npm run test:unit",
    "check:release": "npm run lint && npm run typecheck && npm test",
    "clean": "rimraf dist",
    "dev": "vite --config vite.gallery.config.ts",
    "generate:icons": "jiti scripts/generateIcons/index.ts",
    "generate:icons:check": "jiti scripts/generateIcons/index.ts --check",
    "lint": "eslint \"**/*.{js,ts,vue}\" package.json --cache --cache-strategy metadata --concurrency auto && stylelint \"**/*.{css,vue}\" --cache --cache-strategy metadata",
    "lint:fix": "eslint \"**/*.{js,ts,vue}\" package.json --fix --cache --cache-strategy metadata --concurrency auto && stylelint \"**/*.{css,vue}\" --fix --cache --cache-strategy metadata",
    "prepack": "npm run build",
    "prepublishOnly": "npm --dry-run=false run check:release",
    "prerelease": "jiti scripts/checkRelease.ts",
    "preview:gallery": "vite preview --config vite.gallery.config.ts",
    "release": "npm run check:release && bumpp",
    "test": "npm run test:unit && npm run test:package && npm run test:e2e",
    "test:coverage": "npm run build && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:serve": "vite --config vite.gallery.config.ts --host 127.0.0.1 --port 4323 --strictPort",
    "test:mutation": "stryker run",
    "test:package": "npm run build && jiti scripts/verifyPackage.ts",
    "test:unit": "npm run build && vitest run",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.build.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components"
  ],
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "focus-trap": "^8.2.3",
    "imask": "^7.6.1",
    "tabbable": "^6.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.62.1",
    "@protoapps/browser-targets": "^0.1.1",
    "@protoapps/eslint-config": "^0.3.7",
    "@protoapps/stylelint-config": "^0.1.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/language-core": "^3.3.6",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.6.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "lefthook": "^2.1.14",
    "publint": "^0.3.24",
    "rimraf": "^6.1.4",
    "stylelint": "^17.15.0",
    "svgo": "^4.0.1",
    "temporal-polyfill": "^1.0.3",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.1.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.6"
  },
  "peerDependencies": {
    "vue": "^3.5.40"
  },
  "allowScripts": {
    "core-js-pure": false,
    "lefthook@2.1.14": true,
    "unrs-resolver": false
  }
}
